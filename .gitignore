.claude
.git
.venv
.venv_sglang
__pycache__
.env
.swp
*.log
*.cast
logs/
tmp
handover/
.compare-seeds/
handover.md
*.md
CLAUDE.md~
previous_handovers.md
functional_requirements_*.md
failure_log.md
tests_output_*.txt
.task1_partials/
tools/skeleton_extractor/target/
.cursor/

# Workspace / generated markdown is ignored (genesis.md, model notes, scratch docs, etc.),
# but the PROJECT's public documentation is tracked — re-include it explicitly.
*.md
!README.md
!CONTRIBUTING.md
!docs/*.md
.grok
# Coverage data (xdist workers leave .coverage.<host>.<pid>.* shards).
# The ratchet BASELINE is committed — it is the coverage floor, not data.
.coverage*
!.coverage_ratchet.json

# The pre-run gate stamp: the content hash of the tree check.sh + the walks last
# passed against. A claim about THIS checkout, never shared between machines.
.pre_run_stamp

# The current batch's commit message, written by the assistant and consumed by
# ./commit.sh. It is overwritten every batch and describes changes that are
# about to be committed, not repository content.
last_commit_message.txt
